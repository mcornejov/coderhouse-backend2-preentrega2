{
  "name": "cafe-aurora-eventos",
  "version": "0.2.0",
  "description": "Plataforma de Eventos e Inscripciones de Café Aurora (Backend II): API REST con Express organizada por capas, MongoDB con Mongoose y registro seguro de usuarios con validaciones, normalización de email y hash de contraseñas con bcrypt.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "esm",
    "mongodb",
    "mongoose",
    "bcrypt",
    "eventos",
    "inscripciones",
    "backend",
    "arquitectura-en-capas"
  ],
  "author": "mcornejov",
  "license": "ISC",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
