# Puerto donde escucha el servidor HTTP
PORT=8080

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión a MongoDB (Atlas o local). Obligatoria: el servidor no arranca sin ella.
# Formato Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/cafe_aurora_eventos?appName=Cluster
# Formato local: mongodb://127.0.0.1:27017/cafe_aurora_eventos
MONGO_URL=mongodb://127.0.0.1:27017/cafe_aurora_eventos

# Secreto para firmar los JSON Web Tokens (se usará en el login de la próxima entrega)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Costo del hash de bcrypt (rondas de salt, entre 10 y 14). Opcional; por defecto 10.
BCRYPT_SALT_ROUNDS=10
